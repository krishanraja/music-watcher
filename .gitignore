# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/

# Audio never gets committed (unreleased music)
*.wav
*.WAV
*.aif
*.aiff
*.flac
*.mp3
*.ogg
*.m4a
tests/fixtures/*
!tests/fixtures/.gitkeep

# trackcard outputs
*.trackcard.md
*.trackcard.json
# ...except Music Inspo's cards: they ARE the structured data (taste/inspo/README.md)
!taste/inspo/cards/*.trackcard.md
!taste/inspo/cards/*.trackcard.json
# ...and the cards of tracks Krish or Calvin pointed at in a session (taste/cards/README.md)
!taste/cards/*.trackcard.md
!taste/cards/*.trackcard.json
# ...and the production engine's cards (engine/README.md)
!engine/productions/cards/*.trackcard.md
!engine/productions/cards/*.trackcard.json
!engine/references/cards/*.trackcard.md
!engine/references/cards/*.trackcard.json

# The engine's worker config and saved Drive listings hold folder ids and emails: never in this public repository
engine/config.json
*.listing.json
